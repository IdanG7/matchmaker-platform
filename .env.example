# This file is not read by anything.
#
# docker compose loads its environment from the directory containing the
# compose file, so the values that matter live in:
#
#     deployments/docker/.env.example  ->  copy to deployments/docker/.env
#
# Copying this file to a root .env produces a stack that starts and then fails
# every request, because the API ends up without a schema or a JWT secret.
#
# To get started:
#
#     cp deployments/docker/.env.example deployments/docker/.env
#     make up
