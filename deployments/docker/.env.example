# Copy to .env in this directory and fill in real values.
#
#     cp deployments/docker/.env.example deployments/docker/.env
#
# docker compose reads .env from the directory holding the compose file, which
# is this one - not the repository root. Compose fails fast if any required
# value is missing.

# Postgres
POSTGRES_USER=multiplayer
POSTGRES_PASSWORD=change-me-in-prod
POSTGRES_DB=multiplayer

# Grafana admin
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-in-prod

# API
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace-with-cryptographically-random-value

# Matchmaker tuning. Wider MMR bands and shorter waits match faster but pair
# players less evenly.
MM_MMR_BAND_INITIAL=100
MM_MMR_BAND_MAX=500
MM_MMR_BAND_GROWTH_PER_SECOND=10
MM_MAX_WAIT_TIME_SECONDS=120

# Game server agent. GAME_REPO_PATH is where the game checkout lives, relative
# to this directory, and GAME_PUBLIC_HOST is the address handed to players -
# it has to be reachable from their machine, so not a container name.
GAME_REPO_PATH=../../../../MP-SDK-Game
GAME_PUBLIC_HOST=localhost
